# ============================================
#  IndiaWiseFiling CRM — Environment Config
#  Copy this file to ".env" and fill in values.
#  NEVER commit the real .env to git.
# ============================================

# --- Server ---
PORT=4000
CORS_ORIGINS=http://localhost:3000,https://indiawisefiling.com,https://www.indiawisefiling.com

# --- Security (CHANGE THESE) ---
JWT_SECRET=replace_with_a_long_random_string_min_32_chars
ADMIN_EMAIL=admin@indiawisefiling.com
ADMIN_PASSWORD=changeme123

# --- Team notification (where new-lead alerts go) ---
TEAM_EMAIL=leads@indiawisefiling.com

# --- Email (SMTP) — optional. Without it, emails are logged not sent. ---
# Examples: Gmail, Zoho, Amazon SES, SendGrid SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="IndiaWiseFiling <noreply@indiawisefiling.com>"

# --- WhatsApp — optional. Without it, messages are logged not sent. ---
# Provider options: "meta" (WhatsApp Cloud API) or "wati"
WHATSAPP_PROVIDER=

# If using Meta WhatsApp Cloud API:
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=

# If using WATI:
WATI_ENDPOINT=
WATI_TOKEN=

# --- Razorpay — optional. Needed to create real orders from CRM. ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
